# Set the AdSense identifiers before requesting a site review.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=

# Own (house) ads in the same ad box. Percentage 0-100 of boxes that show a house ad
# when AdSense is configured (default 50). Without AdSense every box shows a house ad;
# set to 0 to show no ads at all until AdSense is approved.
NEXT_PUBLIC_HOUSE_AD_SHARE=
# Landing site for house ads (default https://virtrust.nl).
NEXT_PUBLIC_HOUSE_AD_URL=

# Public contact address shown on the privacy and contact pages.
NEXT_PUBLIC_CONTACT_EMAIL=
# Public URL without trailing slash (canonical links, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://nettoplaatje.nl

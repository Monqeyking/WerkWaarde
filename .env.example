# Set the AdSense identifiers before requesting a site review.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=

# Own (house) ads for Virtrust, in their own box next to the AdSense box.
# On by default; set to 0 to hide them.
NEXT_PUBLIC_HOUSE_ADS=
# Landing site for house ads (default https://virtrust.nl).
NEXT_PUBLIC_HOUSE_AD_URL=

# Public contact address shown on the privacy and contact pages.
NEXT_PUBLIC_CONTACT_EMAIL=
# Public URL without trailing slash (canonical links, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://nettoplaatje.nl

# Set to 1 to also offer tax years that are not final yet (marked "voorlopig"),
# for checking them locally. Leave empty in production.
NEXT_PUBLIC_PREVIEW_TAX_YEARS=

# Cloudflare Web Analytics site token (cookieless visit counts). Dashboard:
# Analytics & Logs > Web Analytics > Add a site > manual JS snippet > the "token" value.
# Public, it ends up in the page source. Empty = no analytics.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

{
  "manifest_version": 3,
  "name": "Nettoplaatje: netto salaris in vacatures",
  "short_name": "Nettoplaatje",
  "version": "1.0.0",
  "description": "Zie bij vacatures op Indeed, Nationale Vacaturebank en Werkzoeken.nl meteen wat je ongeveer netto overhoudt.",
  "homepage_url": "https://nettoplaatje.nl",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Nettoplaatje",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://nl.indeed.com/*",
        "https://www.nationalevacaturebank.nl/*",
        "https://www.werkzoeken.nl/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

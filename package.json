{
  "name": "nettoplaatje",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/flatten-segments.mjs && node scripts/content-dates.mjs",
    "start": "wrangler dev --port 3000",
    "deploy": "npm run build && wrangler deploy && node scripts/indexnow.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "build:extension": "node scripts/build-extension.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "wrangler": "^4.162.0"
  },
  "type": "module"
}
